PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/bix
# Set to "true" when DATABASE_URL points at a managed/hosted Postgres
# instance (Render, Railway, Supabase, Neon, ...) - these require SSL on
# external connections. Leave unset for local development.
DATABASE_SSL=false
JWT_SECRET=replace-with-a-real-secret
# How long an issued login token stays valid. Keep at 8h or less per the
# security baseline (NFR-01) unless the team decides otherwise.
JWT_EXPIRES_IN=8h
# Comma-separated list of frontend origins allowed to call this API.
# Defaults to the client dev server (http://localhost:5173) if unset.
CORS_ORIGIN=http://localhost:5173
# The frontend's own base URL, used to build the link sent in a password
# reset email (US-14) - e.g. https://bix.example.com/reset-password?token=...
# Same value as CORS_ORIGIN in practice, but a separate setting: this one is
# consumed server-side to build a link, not to gate who may call the API.
APP_ORIGIN=http://localhost:5173
# Real outbound email for password reset (US-14). Optional - if either is
# left unset, nothing is sent (the demo mailbox below is the only way to see
# the link). Sent via Brevo's HTTP API (not SMTP - most cloud hosts, Render
# included, block outbound SMTP ports on free/shared tiers). BREVO_API_KEY:
# Brevo dashboard -> SMTP & API -> API Keys, a key scoped to "Transactional
# email: All" only. BREVO_SENDER_EMAIL must be a sender verified in that
# same Brevo account (Senders, Domains & Dedicated IPs) - Brevo itself
# rejects sending from an unverified address. Set real values only on the
# deployed host - never commit them.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Enables GET /api/auth/demo-mailbox, a local-only stand-in for email (shows
# the last 20 reset links, unauthenticated). Off by default - now that real
# email delivery works, this is a dev convenience only, not something a
# deployed environment should expose: it would let anyone who finds the URL
# read a live reset link for any account that recently requested one. Set to
# "true" for local development if you want it; leave unset everywhere else.
DEMO_MAILBOX_ENABLED=true
