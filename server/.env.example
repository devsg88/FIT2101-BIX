PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/bix
JWT_SECRET=replace-with-a-real-secret
# How long an issued login token stays valid. Keep at 8h or less per the
# security baseline (NFR-01) unless the team decides otherwise.
JWT_EXPIRES_IN=8h
# Comma-separated list of frontend origins allowed to call this API.
# Defaults to the client dev server (http://localhost:5173) if unset.
CORS_ORIGIN=http://localhost:5173
# The frontend's own base URL, used to build the link sent in a password
# reset email (US-14) - e.g. https://bix.example.com/reset-password?token=...
# Same value as CORS_ORIGIN in practice, but a separate setting: this one is
# consumed server-side to build a link, not to gate who may call the API.
APP_ORIGIN=http://localhost:5173
